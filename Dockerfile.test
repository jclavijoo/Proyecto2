# Ejecuta las pruebas unitarias en contenedor (como Niveles/3/CICD/unit_testing/demo_app).
# Desde la raíz del repositorio:
#   docker build -f Dockerfile.test -t mlops-p2-tests .
#   docker run --rm mlops-p2-tests
FROM python:3.12-slim

WORKDIR /app

COPY api/requirements.txt /app/api/requirements.txt
COPY requirements-test.txt /app/
RUN pip install --no-cache-dir -r api/requirements.txt -r requirements-test.txt

COPY api/ /app/api/
COPY airflow/dags/diabetes_pipeline/features.py /app/airflow/dags/diabetes_pipeline/features.py
COPY tests/ /app/tests/
COPY pytest.ini /app/

CMD ["pytest", "-v"]
